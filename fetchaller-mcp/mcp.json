{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fetchaller": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Averyy/fetchaller-mcp@500078f7f349d080de1fb7f231cd5d11f3fc42d2",
        "--with",
        "wafer-py[browser]==0.7.14",
        "fetchaller-mcp"
      ],
      "env": {
        "BROWSER_EXECUTABLE_PATH": "${BROWSER_EXECUTABLE_PATH}"
      }
    }
  }
}
