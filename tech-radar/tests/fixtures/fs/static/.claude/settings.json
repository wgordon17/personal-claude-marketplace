{
  "model": "claude-sonnet-5-5",
  "enabledPlugins": {
    "tech-radar@personal-claude-marketplace": true,
    "code-quality@personal-claude-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run guard.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status"
          }
        ]
      }
    ]
  },
  "env": {
    "EXAMPLE_MODE": "synthetic"
  }
}
