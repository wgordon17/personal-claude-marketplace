{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Managed by khepri-deps/renovate — global config provides weekly Monday schedule, 14-day release cooldown, and vulnerability alert bypass."
  ],
  "ignorePaths": [
    "skill-eval/codebases/**"
  ],
  "pep723": {
    "managerFilePatterns": [
      "/(^|/)hooks/[^/]+\\.py$/",
      "/(^|/)scripts/[^/]+\\.py$/",
      "/^\\.claude/commands/[^/]+\\.py$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep skillsaw version synchronized across config, pre-commit, CI workflow, and CLAUDE.md",
      "managerFilePatterns": [
        "/^\\.skillsaw\\.yaml$/",
        "/^\\.pre-commit-config\\.yaml$/",
        "/^\\.github/workflows/plugin-lint\\.yml$/",
        "/^CLAUDE\\.md$/"
      ],
      "matchStrings": [
        "(?:^|\\n)version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "uvx\\s+skillsaw@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "skillsaw",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Track tagged fetchaller-mcp releases and commit digests in fetchaller-mcp/README.md",
      "managerFilePatterns": [
        "/^fetchaller-mcp/README\\.md$/"
      ],
      "matchStrings": [
        "\\[`(?<currentValue>v\\d+\\.\\d+\\.\\d+)`\\]\\(https://github\\.com/Averyy/fetchaller-mcp/commit/(?<currentDigest>[0-9a-f]{40})\\)"
      ],
      "depNameTemplate": "Averyy/fetchaller-mcp",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track pinned wafer-py version in fetchaller-mcp MCP server manifests",
      "managerFilePatterns": [
        "/^fetchaller-mcp/\\.mcp\\.json$/",
        "/^fetchaller-mcp/mcp\\.json$/"
      ],
      "matchStrings": [
        "\"wafer-py\\[browser\\]==(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "wafer-py",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Group skillsaw version updates across config, pre-commit, CI, and docs",
      "matchPackageNames": [
        "skillsaw"
      ],
      "groupName": "skillsaw"
    },
    {
      "description": "Group fetchaller-mcp and wafer-py into a monthly, non-automerged audit-trigger PR",
      "matchPackageNames": [
        "Averyy/fetchaller-mcp",
        "wafer-py"
      ],
      "groupName": "fetchaller-mcp",
      "automerge": false,
      "schedule": [
        "* 0-8 1-7 * 1"
      ],
      "prBodyNotes": [
        "**Security audit required before merge (CI fails closed by design):** Follow `fetchaller-mcp/README.md` (`Manual update process`) — review every upstream commit and `uv.lock` diff, align `.mcp.json` / `mcp.json` / `README.md` pins, re-audit all MCP tools and update attested commit SHAs in `fetchaller-mcp/README.md` (`Tool capability audit`) and `dev-guard/hooks/mcp_constants.py` (`MCP_READ_ONLY` + `fetch` parameter names), run `uv run --no-project python -I .github/scripts/skillsaw_custom_rules.py --fix` and `make test-live`, and update `TestFetchallerMcpConfigSecurity` in `dev-guard/tests/test_plugin_integrity.py`."
      ]
    },
    {
      "description": "Verify PyPI source and auto-bump 3 plugin manifests when PyPI dependencies inside a plugin directory are updated",
      "matchFileNames": [
        "pyright-uvx/**",
        "vtsls-npx/**",
        "gopls-go/**",
        "vscode-html-css-npx/**",
        "rust-analyzer-rustup/**",
        "dev-guard/**",
        "code-quality/**",
        "git-tools/**",
        "github-mcp/**",
        "jira/**",
        "drawio/**",
        "fetchaller-mcp/**",
        "chai-bot/**",
        "standup/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "postUpgradeTasks": {
        "commands": [
          "khepri-verify-pypi-source '{{{packageName}}}' '{{{newVersion}}}'",
          "uv run --no-project python -I .github/scripts/skillsaw_custom_rules.py --fix"
        ],
        "executionMode": "update"
      }
    },
    {
      "description": "Auto-bump 3 plugin manifests when non-PyPI dependencies inside a plugin directory are updated",
      "matchFileNames": [
        "pyright-uvx/**",
        "vtsls-npx/**",
        "gopls-go/**",
        "vscode-html-css-npx/**",
        "rust-analyzer-rustup/**",
        "dev-guard/**",
        "code-quality/**",
        "git-tools/**",
        "github-mcp/**",
        "jira/**",
        "drawio/**",
        "fetchaller-mcp/**",
        "chai-bot/**",
        "standup/**"
      ],
      "matchDatasources": [
        "!pypi"
      ],
      "postUpgradeTasks": {
        "commands": [
          "uv run --no-project python -I .github/scripts/skillsaw_custom_rules.py --fix"
        ],
        "fileFilters": [
          "*/.claude-plugin/plugin.json",
          "*/plugin.json",
          ".claude-plugin/marketplace.json",
          "*/mcp.json",
          "dev-guard/hooks/hooks.json"
        ],
        "executionMode": "update"
      }
    }
  ]
}
